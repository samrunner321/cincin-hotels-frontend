# Production Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_DIRECTUS_URL=https://your-directus-domain.com
DIRECTUS_ADMIN_TOKEN=your_admin_token_here
DIRECTUS_PUBLIC_TOKEN=your_public_token_here
DIRECTUS_TOKEN=your_api_token_here

# Revalidation Secret (generate a strong random string)
REVALIDATION_SECRET=your_random_secret_here

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_SUPPORTED_LOCALES=en-US,de-DE,ar-AE,he-IL

# Cache Control (in seconds)
NEXT_PUBLIC_REVALIDATE_HOTEL=300
NEXT_PUBLIC_REVALIDATE_DESTINATION=600
NEXT_PUBLIC_REVALIDATE_CATEGORY=1800
NEXT_PUBLIC_REVALIDATE_PAGE=3600
NEXT_PUBLIC_REVALIDATE_TRANSLATIONS=86400

# Production Mode
IS_MOCK_SERVER=false
NEXT_PUBLIC_USE_MOCK_DATA=false
FORCE_MOCK_TRANSLATIONS=false

# Debug Mode (set to false for production)
DEBUG_MODE=false

# Database (for Directus on VPS)
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=directus
# DB_USER=directus
# DB_PASSWORD=your_secure_password

# Email Configuration (optional, for Directus)
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.your-provider.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your_email_user
# EMAIL_SMTP_PASSWORD=your_email_password

# Storage (optional, for file uploads)
# STORAGE_LOCATIONS=local
# STORAGE_LOCAL_DRIVER=local
# STORAGE_LOCAL_ROOT=./uploads